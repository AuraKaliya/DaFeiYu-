{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "VS2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "BUILD_GUI": "ON",
        "BUILD_CLI": "OFF"
      }
    },
    {
      "name": "windows-cli",
      "inherits": "windows",
      "displayName": "Desktop with optional CLI",
      "binaryDir": "${sourceDir}/build/rebuild/windows-cli",
      "cacheVariables": { "BUILD_CLI": "ON" }
    },
    {
      "name": "windows-tests",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/rebuild/windows-tests",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "BUILD_GUI": "OFF",
        "BUILD_CLI": "ON"
      }
    },
    {
      "name": "windows-ui",
      "inherits": "windows-tests",
      "binaryDir": "${sourceDir}/build/rebuild/windows-ui",
      "cacheVariables": {
        "BUILD_GUI": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-build",
      "hidden": true,
      "jobs": 4
    },
    {
      "name": "windows-debug",
      "inherits": "windows-build",
      "configurePreset": "windows",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "inherits": "windows-build",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "windows-cli-debug",
      "inherits": "windows-debug",
      "configurePreset": "windows-cli"
    },
    {
      "name": "windows-cli-release",
      "inherits": "windows-release",
      "configurePreset": "windows-cli"
    },
    {
      "name": "windows-tests",
      "inherits": "windows-build",
      "configurePreset": "windows-tests",
      "configuration": "Debug"
    },
    {
      "name": "windows-tests-debug",
      "inherits": "windows-tests"
    },
    {
      "name": "windows-tests-release",
      "inherits": "windows-tests",
      "configuration": "Release"
    },
    {
      "name": "windows-ui-debug",
      "inherits": "windows-build",
      "configurePreset": "windows-ui",
      "configuration": "Debug",
      "targets": ["dafeiyu"]
    },
    {
      "name": "windows-ui-release",
      "inherits": "windows-ui-debug",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-tests",
      "configurePreset": "windows-tests",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
