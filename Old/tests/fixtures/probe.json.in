{
  "id": "test.probe",
  "version": "0.5.0",
  "abi_version": 2,
  "library": "@LIBRARY@",
  "requires": [
    {
      "binding": "memory",
      "contract": "dafeiyu.memory",
      "version": 2
    },
    {
      "binding": "memory.changes",
      "contract": "test.memory.changes",
      "version": 1
    }
  ],
  "services": [
    {
      "id": "fixture.probe",
      "contract": "dafeiyu.action-executor",
      "version": 1,
      "capabilities": [
        "readiness"
      ]
    }
  ],
  "actions": [
    {
      "id": "fixture.action",
      "revision": 1,
      "description": "Test fixture",
      "service": "fixture.probe",
      "method": "execute",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "effects": "read",
      "resource": "memory"
    }
  ]
}
