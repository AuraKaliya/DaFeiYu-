{
  "id": "dafeiyu.action.search",
  "version": "0.5.0",
  "abi_version": 2,
  "library": "@LIBRARY@",
  "requires": [
    {
      "binding": "search",
      "contract": "example.search",
      "version": 1
    }
  ],
  "services": [
    {
      "id": "action.search",
      "contract": "dafeiyu.action-executor",
      "version": 1,
      "capabilities": [
        "readiness"
      ]
    }
  ],
  "actions": [
    {
      "id": "action.search",
      "service": "action.search",
      "method": "execute",
      "revision": 1,
      "description": "action.search",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 65536
          },
          "options": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            },
            "required": [
              "limit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "query",
          "options"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "effects": "read",
      "resource": "web"
    }
  ]
}
