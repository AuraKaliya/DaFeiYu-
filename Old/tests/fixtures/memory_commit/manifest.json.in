{
  "id": "dafeiyu.action.remember",
  "version": "0.5.0",
  "abi_version": 2,
  "library": "@LIBRARY@",
  "requires": [
    {
      "binding": "memory",
      "contract": "dafeiyu.memory",
      "version": 2
    },
    {
      "binding": "memory.changes",
      "contract": "test.memory.changes",
      "version": 1
    }
  ],
  "services": [
    {
      "id": "action.remember",
      "contract": "dafeiyu.action-executor",
      "version": 1,
      "capabilities": [
        "readiness",
        "query"
      ]
    }
  ],
  "actions": [
    {
      "id": "action.remember",
      "service": "action.remember",
      "method": "execute",
      "revision": 1,
      "description": "action.remember",
      "input": {
        "type": "object",
        "properties": {
          "persona": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "persona"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "effects": "local-write",
      "resource": "memory",
      "query": "query_operation",
      "delegates": {
        "resources": [
          "instance",
          "memory"
        ],
        "effects": [
          "read",
          "local-write"
        ]
      }
    }
  ]
}
