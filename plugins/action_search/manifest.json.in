{
  "id": "dafeiyu.action.search",
  "version": "0.2.0",
  "abi_version": 2,
  "library": "@LIBRARY@",
  "requires": [
    {
      "binding": "search",
      "contract": "example.search",
      "version": 1
    }
  ],
  "services": [
    {
      "id": "action.search",
      "contract": "example.search-action",
      "version": 1,
      "methods": {
        "execute": {
          "input": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "maxLength": 65536
              },
              "options": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                },
                "required": [
                  "limit"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "query",
              "options"
            ],
            "additionalProperties": false
          },
          "output": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "effects": "read",
          "resource": "web"
        },
        "readiness": {
          "input": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "output": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "effects": "read",
          "resource": "instance"
        }
      }
    }
  ],
  "actions": [
    {
      "id": "action.search",
      "service": "action.search",
      "method": "execute",
      "revision": 1,
      "description": "action.search",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 65536
          },
          "options": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            },
            "required": [
              "limit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "query",
          "options"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "effects": "read",
      "resource": "web"
    }
  ]
}
