{
  "schema": "dafeiyu.status_definitions/1",
  "readWith": "mc.companion/observe",
  "definitions": [{
    "key": "mc.companion.task_goal",
    "version": 1,
    "description": "MC 伙伴为配对玩家登记的当前任务目标。主体为玩家 UUID，事实号沿用本次会话的原执行修订号。",
    "defaultAttention": {"mode": "explicit"},
    "valueSchema": {
      "type": "object",
      "properties": {"goal": {"type": "string"}},
      "required": ["goal"],
      "additionalProperties": false
    }
  }, {
    "key": "mc.companion.pending_approval",
    "version": 1,
    "description": "原工作等待玩家裁定，主体是工作号，事实号是审批候选号。",
    "defaultAttention": {"mode": "implicit"},
    "valueSchema": {
      "type": "object",
      "properties": {"order": {"type": "integer"}, "skill": {"type": "string"}},
      "required": ["order", "skill"],
      "additionalProperties": false
    }
  }, {
    "key": "mc.companion.approval_result",
    "version": 1,
    "description": "审批已结算的原工作及其未执行原因，事实号和唤醒号沿用该信箱的原消息号。",
    "defaultAttention": {"mode": "implicit"},
    "valueSchema": {
      "type": "object",
      "properties": {
        "mailbox": {"type": "integer"}, "id": {"type": "integer"}, "order": {"type": "integer"},
        "skill": {"type": "string"}, "status": {"type": "string"}, "source": {"type": "string"},
        "execution": {"type": "string"}, "player": {"type": "string"}, "generation": {"type": "string"}
      },
      "required": ["mailbox", "id", "order", "skill", "status", "source", "execution", "player", "generation"],
      "additionalProperties": false
    }
  }, {
    "key": "mc.companion.pickup_effect",
    "version": 1,
    "description": "沿原拾取工作和实效回执核对指定一堆物品。target 为原整堆，acquired 为本方经收取包和库存双重核实的入包数，other 为其他实体收取数。pendingPickup 仅在原堆有实读余量或全部去向已核清时提供。",
    "defaultAttention": {"mode": "implicit"},
    "valueSchema": {
      "type": "object",
      "properties": {
        "observation": {"type": "string"}, "entity": {"type": "string"}, "item": {"type": "string"},
        "dimension": {"type": "string"}, "target": {"type": "integer"}, "acquired": {"type": "integer"},
        "other": {"type": "integer"}, "pendingPickup": {"type": "integer"},
        "remainingState": {"type": "string", "enum": ["observed", "accounted", "unknown"]}
      },
      "required": ["observation", "entity", "item", "dimension", "target", "acquired", "other", "remainingState"],
      "additionalProperties": false
    }
  }, {
    "key": "mc.companion.world_environment",
    "version": 1,
    "description": "伙伴客户端一次世界查询读到的维度及背包圆石数量，主体是角色 UUID。sampledUtcMs 是插件收到原读回的时间，validUntilUtcMs 是下一次应复查时间，服务端最近信号年龄独立记录。",
    "defaultAttention": {"mode": "implicit"},
    "valueSchema": {
      "type": "object",
      "properties": {
        "read": {"type": "string"}, "generation": {"type": "string"}, "dimension": {"type": "string"},
        "cobblestone": {"type": "integer"}, "signalAgeMs": {"type": "integer"}, "coverage": {"type": "string"}
      },
      "required": ["read", "generation", "dimension", "cobblestone", "signalAgeMs", "coverage"],
      "additionalProperties": false
    }
  }]
}
