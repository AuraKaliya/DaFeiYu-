{
  "id": "dafeiyu.action.add", "version": "0.1.0", "abi_version": 1,
  "library": "@LIBRARY@", "requires": [],
  "services": [{
    "id": "action.add", "kind": "action", "version": 1, "effects": "read",
    "description": "Add two bounded integers; no external side effects.",
    "input_schema": {
      "type": "object", "additionalProperties": false, "required": ["a", "b"],
      "properties": {
        "a": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "b": {"type": "integer", "minimum": -1000000, "maximum": 1000000}
      }
    }
  }]
}
