# 先经正式宿主留存语气纠正，再将关闭后的同一份数据库交给各独立进程。
string(RANDOM LENGTH 16 run_id)
set(run "${ROOT}/${run_id}")
set(prefix "")
set(seed_phase seed)
set(phases A B guards)
if(RECENT_CHAT)
  set(prefix recent-)
  set(seed_phase recent-seed)
  set(phases A B)
elseif(SEMANTIC_CHAT)
  set(prefix semantic-)
  set(seed_phase chat-seed)
  set(phases A-paraphrase B-paraphrase A-refund B-refund A-unclear B-unclear A-literal B-literal)
elseif(PRIVATE_CHAT)
  set(prefix chat-)
  set(seed_phase chat-seed)
  list(APPEND phases preflight)
else()
  list(APPEND phases crash)
endif()
execute_process(COMMAND "${PROGRAM}" --tone "${run}" "${seed_phase}" COMMAND_ERROR_IS_FATAL ANY)
set(database main-conversation.sqlite3)
file(SHA256 "${run}/seed/${database}" snapshot)
message(STATUS "Tone replay SQLite SHA256 ${snapshot}")
foreach(phase IN LISTS phases)
  file(MAKE_DIRECTORY "${run}/${phase}")
  file(COPY_FILE "${run}/seed/${database}" "${run}/${phase}/${database}")
  file(SHA256 "${run}/${phase}/${database}" copied)
  if(NOT copied STREQUAL snapshot)
    message(FATAL_ERROR "${phase} received a different SQLite snapshot")
  endif()
  if(phase STREQUAL crash)
    execute_process(COMMAND "${PROGRAM}" --tone "${run}" crash RESULT_VARIABLE stopped)
    if(NOT stopped EQUAL 23)
      message(FATAL_ERROR "expected interruption after staging a correction, got ${stopped}")
    endif()
    execute_process(COMMAND "${PROGRAM}" --tone "${run}" recover COMMAND_ERROR_IS_FATAL ANY)
  elseif(RECENT_CHAT)
    execute_process(COMMAND "${PROGRAM}" --tone "${run}" "${prefix}${phase}"
      COMMAND_ERROR_IS_FATAL ANY OUTPUT_VARIABLE "reply_${phase}" OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(COMMAND "${PROGRAM}" --tone "${run}" "recent-recover-${phase}" COMMAND_ERROR_IS_FATAL ANY)
  else()
    execute_process(COMMAND "${PROGRAM}" --tone "${run}" "${prefix}${phase}" COMMAND_ERROR_IS_FATAL ANY)
  endif()
endforeach()
if(RECENT_CHAT)
  if(NOT reply_B LESS reply_A)
    message(FATAL_ERROR "Recent summary did not reduce reply bytes ${reply_A} → ${reply_B}")
  endif()
  message(STATUS "Pending correction continuation bytes ${reply_A} → ${reply_B}")
  file(MAKE_DIRECTORY "${run}/revoked")
  file(COPY_FILE "${run}/B/${database}" "${run}/revoked/${database}")
  execute_process(COMMAND "${PROGRAM}" --tone "${run}" recent-revoked COMMAND_ERROR_IS_FATAL ANY)
endif()
