{
  "id": "test.call-tree.root",
  "version": "0.5.0",
  "abi_version": 2,
  "library": "@LIBRARY@",
  "requires": [
    {
      "binding": "tree.relay",
      "contract": "test.call-tree.relay",
      "version": 1
    },
    {
      "binding": "tree.leaf",
      "contract": "test.call-tree.leaf",
      "version": 1
    }
  ],
  "services": [
    {
      "id": "tree.root",
      "contract": "dafeiyu.action-executor",
      "version": 1,
      "capabilities": [
        "query"
      ]
    }
  ],
  "actions": [
    {
      "id": "fixture.tree.read",
      "revision": 1,
      "description": "Read-only call-tree fixture",
      "service": "tree.root",
      "method": "execute",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "effects": "read",
      "resource": "alpha",
      "resources": [
        "alpha",
        "beta"
      ],
      "delegates": {
        "effects": [
          "read"
        ],
        "resources": [
          "alpha",
          "beta"
        ]
      }
    },
    {
      "id": "fixture.tree.write",
      "revision": 1,
      "description": "Composite call-tree fixture",
      "service": "tree.root",
      "method": "execute",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "effects": "external-write",
      "resource": "alpha",
      "resources": [
        "alpha",
        "beta"
      ],
      "delegates": {
        "effects": [
          "read",
          "local-write",
          "external-write"
        ],
        "resources": [
          "alpha",
          "beta"
        ]
      },
      "query": "query_operation"
    }
  ]
}
