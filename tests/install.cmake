string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(prefix "${WORK}/installed-${suffix}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD}" --config "${CONFIG}" --prefix "${prefix}"
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Install failed: ${out} ${err}")
endif()
file(GLOB manifests "${prefix}/plugins/*.json")
list(LENGTH manifests manifest_count)
if(EXAMPLES)
  if(NOT manifest_count EQUAL 5 OR NOT EXISTS "${prefix}/profiles/minimal.json")
    message(FATAL_ERROR "Example install must contain exactly the five minimal manifests")
  endif()
  foreach(manifest IN LISTS manifests)
    if(manifest MATCHES "dfy_fixture_|dfy_test_")
      message(FATAL_ERROR "Test fixture leaked into installation: ${manifest}")
    endif()
  endforeach()
elseif(manifest_count GREATER 0 OR EXISTS "${prefix}/profiles")
  message(FATAL_ERROR "Core/SDK installation must not install examples or fixtures")
endif()
set(platform_args)
if(PLATFORM)
  list(APPEND platform_args -A "${PLATFORM}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${CONSUMER}" -B "${prefix}/consumer-build" -G "${GENERATOR}" ${platform_args}
  "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_INSTALL_PREFIX=${prefix}" "-DCMAKE_BUILD_TYPE=${CONFIG}"
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Standalone SDK configure failed: ${out} ${err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${prefix}/consumer-build" --config "${CONFIG}"
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Standalone SDK build failed: ${out} ${err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${prefix}/consumer-build" --config "${CONFIG}"
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Standalone SDK install failed: ${out} ${err}")
endif()
if(NOT EXAMPLES)
  message(STATUS "Core/SDK-only install and independent SDK compilation passed")
  return()
endif()
file(READ "${prefix}/profiles/minimal.json" profile)
string(JSON length LENGTH "${profile}" plugins)
string(JSON profile SET "${profile}" plugins ${length} "{\"manifest\":\"external.json\",\"revision\":\"1\",\"config\":{}}")
string(JSON action_length LENGTH "${profile}" allowed_actions)
string(JSON profile SET "${profile}" allowed_actions ${action_length} "\"action.double\"")
string(JSON profile SET "${profile}" plugins 0 config "{\"action\":\"action.double\",\"arguments\":{\"value\":8}}")
file(WRITE "${prefix}/profiles/extended.json" "${profile}")
file(GLOB binaries "${prefix}/bin/dafeiyu*")
list(GET binaries 0 executable)
execute_process(COMMAND "${executable}" demo --profile "${prefix}/profiles/extended.json" --state "${prefix}/state"
  WORKING_DIRECTORY "${prefix}" ENCODING UTF-8 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "External plugin runtime failed: ${out} ${err}")
endif()
string(JSON execution GET "${out}" execution)
string(JSON value GET "${out}" results 0 outcome data value)
if(NOT execution STREQUAL completed OR NOT value EQUAL 16)
  message(FATAL_ERROR "External SDK plugin did not execute: ${out}")
endif()
message(STATUS "Installed runtime executed an independently built SDK plugin")
