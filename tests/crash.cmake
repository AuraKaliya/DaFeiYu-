string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(state "${WORK}/crash-${MODE}-${suffix}")
execute_process(COMMAND "${DRIVER}" "${MODE}" crash "${PROFILE}" "${state}" RESULT_VARIABLE crashed OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT crashed EQUAL 73)
  message(FATAL_ERROR "Expected hard exit 73, got ${crashed}: ${out} ${err}")
endif()
execute_process(COMMAND "${DRIVER}" "${MODE}" resume "${PROFILE}" "${state}" RESULT_VARIABLE resumed OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT resumed EQUAL 0)
  message(FATAL_ERROR "Recovery failed: ${out} ${err}")
endif()
message(STATUS "${out}")
