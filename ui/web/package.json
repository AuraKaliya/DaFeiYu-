{
  "name": "dafeiyu-u01-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.13.0 <25" },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:history": "node --experimental-strip-types --test tests/message-history.test.mjs",
    "build:mc-trace": "vue-tsc -p mc-trace/tsconfig.json --noEmit && vite build --config vite.mc-trace.config.ts",
    "start:mc-trace": "vite preview --config vite.mc-trace.config.ts",
    "test:mc-trace": "node --test mc-trace/*.test.mjs"
  },
  "dependencies": { "reka-ui": "2.11.0", "vue": "3.5.45" },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
